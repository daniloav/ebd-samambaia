# Modelo de configuração do lançamento OCI.
# Copie para .oci-launch.env e preencha com os valores do ./oci-descobrir.sh:
#   cp scripts/.oci-launch.env.example scripts/.oci-launch.env

COMPARTMENT_ID="COLE_AQUI_ocid1.tenancy_ou_compartment"
SUBNET_ID="COLE_AQUI_ocid1.subnet"          # subnet PÚBLICA
IMAGE_ID="COLE_AQUI_ocid1.image"            # Ubuntu 22.04 ARM (aarch64)

SSH_KEY_FILE="$HOME/.ssh/id_ed25519.pub"    # sua chave PÚBLICA
DISPLAY_NAME="ebd-server"

OCPUS=1                                       # 1 OCPU acha capacidade mais fácil
MEM_GB=6                                      # folgado para o projeto

# Availability Domain(s) — nomes reais do oci-descobrir.sh. Ex.:
ADS=("COLE_AQUI_AD-1")

SLEEP_SECONDS=60                              # espera entre tentativas
