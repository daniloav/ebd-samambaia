# Copie para .env e ajuste. Usado pelo docker-compose.yml (stack de produção).

# Banco de dados
POSTGRES_DB=ebd
POSTGRES_USER=ebd
POSTGRES_PASSWORD=troque-esta-senha

# Usuários iniciais criados no primeiro boot (troque em produção!)
EBD_ADMIN_USERNAME=admin
EBD_ADMIN_PASSWORD=troque-admin
EBD_PROFESSOR_USERNAME=professor
EBD_PROFESSOR_PASSWORD=troque-prof

# --- Alertas por e-mail (opcional) ---
# Deixe EBD_NOTIF_ENABLED=false para não enviar nada.
# Para ligar: crie uma conta grátis (ex.: Brevo), gere uma chave SMTP e preencha USER/PASS.
EBD_NOTIF_ENABLED=false
EBD_MAIL_FROM=EBD ICE Samambaia <no-reply@ebd-ices.duckdns.org>
EBD_SMTP_HOST=smtp-relay.brevo.com
EBD_SMTP_PORT=587
EBD_SMTP_USER=
EBD_SMTP_PASS=
